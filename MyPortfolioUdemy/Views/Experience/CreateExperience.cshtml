@model Experience
@{
    ViewData["Title"] = "CreateExperience";
    Layout = "~/Views/Layout/Index.cshtml";
}


<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Deneyimler</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Deneyim Ekleme</div>
					</div>
					<div class="card-body">
						<div class="card-sub">
							Deneyimler ile İlgili ekleme işlemleri aşağıdaki panelde yapabilirsiniz :
						</div>
						<form method="post">
							<label>Deneyim Başlığı - Firma Bilgisi</label>
							<input type="text" asp-for="Head" class="form-control" />
							<br />
							<label>Çalışılan Pozisyon</label>
							<input type="text" asp-for="Title" class="form-control" />
							<br />
							<label>Tarih Bilgisi</label>
							<input type="text" asp-for="Date" class="form-control" />
							<br />
							<label>Açıkla</label>
							<textarea rows="4" asp-for="Description"></textarea>
							<br />
							<button class="btn btn-primary"> Deneyim ekle</button>
						</form>
						<a href="/Experience/CreateExperience/" class="btn btn-info">Ekle</a>
					</div>
				</div>
			</div>

		</div>
	</div>
</div>
