@model SocialMedia
@{
	ViewData["Title"] = "CreateSocialMedia";
	Layout = "~/Views/Layout/Index.cshtml";
}


<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Sosyal Medya Ekle</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Adres Ekleme</div>
					</div>
					<div class="card-body">
						<div class="card-sub">
							Sosyal Medya ile İlgili ekleme işlemleri aşağıdaki panelde yapabilirsiniz :
						</div>
						<form method="post">
							<label>Sosyal Medya Adı</label>
							<input type="text" asp-for="Title" class="form-control" />
							<br />
							<label>Sosyal Medya Bağlantısı</label>
							<input type="text" asp-for="Url" class="form-control" />
							<br />
							<label>Sosyal Medya Iconu</label>
							<input type="text" asp-for="Icon" class="form-control" />
							<br />
							<button class="btn btn-primary"> Ekle</button>
						</form>
					</div>
				</div>
			</div>

		</div>
	</div>
</div>
