@model Message
@{
    ViewData["Title"] = "MessageDetail";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Mesajlar</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Mesaj Detayı</div>
					</div>
					<input type="hidden" asp-for="MessageId"/>
					<div class="card-body">
						<div class="card-sub">
                            Gönderen: @Model.NameSurname <br />
                            Konu: @Model.Subject <br />
                            Tarih: @Model.SendDate.ToShortDateString() <br />
                            Mesaj: @Model.MessageDetail <br />
						</div>
					
					</div>
				</div>
			</div>

		</div>
	</div>
</div>